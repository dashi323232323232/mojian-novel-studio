{
  "name": "dashi-novel-studio",
  "productName": "大师小说工作台",
  "version": "1.2.0",
  "description": "简洁的 AI 长篇小说创作工作台：项目管理、章节写作、图形化大纲、伏笔追踪、有声小说与本地 Agent API。",
  "main": "dist/electron/electron/main/index.js",
  "author": "Dashi Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "test": "tsx --test tests/unit/*.test.ts tests/api/*.test.ts",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "openapi": "tsx scripts/write-openapi.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "playwright-core": "^1.56.0",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}